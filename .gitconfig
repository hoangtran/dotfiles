[user]
	name = Hoang Tran
	email = hoang.tran@vnoss.org
[color]
	branch = auto
	diff = auto
	grep = auto
	interactive = auto
	status = auto
[alias]
	la = !git config --get-regexp '^alias[.]'
	last = cat-file commit HEAD
	st = status
	ci = commit
	co = checkout
	chp = cherry-pick
	b = branch
	dc = diff --cached
	r = reset
	rh = reset --hard
	rs = reset --soft
	unstage = reset HEAD --
	fl = log -u
	filelog = log -u
	lp = log -p --cc --decorate=short
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	ctags = "!f() { git_common_dir=`git rev-parse --git-common-dir`; [ -f $git_common_dir/hooks/ctags ] || git init; $git_common_dir/hooks/ctags; }; f"
[branch]
	autosetuprebase = always
[credential]
	helper = cache --timeout=3600
[push]
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
[core]
	excludesfile = /home/hoangtran/.global_ignore
	untrackedCache = true
[init]
	templatedir = ~/.git_template
	defaultBranch = main
[help]
	autocorrect = 8
[mergetool "fugitive"]
	cmd = vim -f -c \"Gvdiff\" \"$MERGED\"
[merge]
	tool = fugitive
[rerere]
	enabled = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
